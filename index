    // Turkish Char & Symbol Normalizer
    function normalizeTr(str) {
      if (!str) return '';
      return str
        .toLowerCase()
        .replace(/ı/g, 'i')
        .replace(/ğ/g, 'g')
        .replace(/ü/g, 'u')
        .replace(/ş/g, 's')
        .replace(/ö/g, 'o')
        .replace(/ç/g, 'c')
        .replace(/[^a-z0-9]/g, '');
    }

    // Levenshtein similarity distance for typos
    function levenshteinDistance(a, b) {
      const m = a.length, n = b.length;
      if (m === 0) return n;
      if (n === 0) return m;
      const dp = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));
      for (let i = 0; i <= m; i++) dp[i][0] = i;
      for (let j = 0; j <= n; j++) dp[0][j] = j;

      for (let i = 1; i <= m; i++) {
        for (let j = 1; j <= n; j++) {
          const cost = a[i - 1] === b[j - 1] ? 0 : 1;
          dp[i][j] = Math.min(
            dp[i - 1][j] + 1,
            dp[i][j - 1] + 1,
            dp[i - 1][j - 1] + cost
          );
        }
      }
      return dp[m][n];
    }

    // Smart Matcher
    function findBestMatch(queryText, masterList, usedCodes) {
      const qNorm = normalizeTr(queryText);
      if (!qNorm) return null;

      // 1. Shorthand Table Check
      if (SHORTCUTS[qNorm]) {
        const target = SHORTCUTS[qNorm];
        const item = masterList.find(m => m.name === target && !usedCodes.has(m.code));
        if (item) return item;
      }

      // 2. Exact Normalized Match
      for (const item of masterList) {
        if (usedCodes.has(item.code)) continue;
        if (normalizeTr(item.name) === qNorm) return item;
      }

      // 3. Substring Inclusion Match
      for (const item of masterList) {
        if (usedCodes.has(item.code)) continue;
        const iNorm = normalizeTr(item.name);
        if (iNorm.includes(qNorm) || (qNorm.length > 5 && qNorm.includes(iNorm))) {
          return item;
        }
      }

      // 4. Token Keyword Matching
      const qTokens = queryText.toLowerCase().replace(/[^a-z0-9ğüşıöç ]/g, ' ').split(/\s+/).filter(t => t.length > 2);
      let bestTokenItem = null;
      let maxTokenScore = 0;

      for (const item of masterList) {
        if (usedCodes.has(item.code)) continue;
        const iNameLower = item.name.toLowerCase();
        let score = 0;
        for (const token of qTokens) {
          if (iNameLower.includes(token)) score++;
        }
        if (score > maxTokenScore && score >= Math.min(2, qTokens.length)) {
          maxTokenScore = score;
          bestTokenItem = item;
        }
      }
      if (bestTokenItem) return bestTokenItem;

      // 5. Fuzzy Levenshtein Distance (typo recovery)
      let bestFuzzyItem = null;
      let minDistance = Infinity;

      for (const item of masterList) {
        if (usedCodes.has(item.code)) continue;
        const iNorm = normalizeTr(item.name);
        const dist = levenshteinDistance(qNorm, iNorm);
        // Allow typo threshold based on word length
        if (dist <= 3 && dist < minDistance) {
          minDistance = dist;
          bestFuzzyItem = item;
        }
      }

      return bestFuzzyItem;
    }

