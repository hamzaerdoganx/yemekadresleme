      { code: "4.4.3.1.0007", name: "WHITE SALMON ROLL", oldLoc: "B-098" },
      { code: "4.4.3.1.0016", name: "KYOTO MIX", oldLoc: "B-099" },
      { code: "4.4.3.1.0017", name: "DORITOS CALIFORNIA ROLL", oldLoc: "B-100" },
      { code: "4.4.4.1.0001", name: "İRMİK HELVASI", oldLoc: "A-036" },
      { code: "4.4.6.1.0001", name: "LİMONATA 300 ML", oldLoc: "B-102" },
      { code: "4.4.6.1.0004", name: "PORTAKAL SUYU 300 ML", oldLoc: "A-040" },
      { code: "4.4.6.1.0010", name: "PORTAKAL SUYU 750 ML", oldLoc: "A-041" },
      { code: "4.4.6.1.0026", name: "HIBISCUS ICE TEA 300 ML", oldLoc: "B-105" },
      { code: "4.4.6.1.0027", name: "HIBISCUS ICE TEA 750 ML", oldLoc: "B-106" },
      { code: "4.4.6.1.0034", name: "VİŞNE HOŞAFI", oldLoc: "A-030" },
      { code: "4.4.6.1.0035", name: "KAYISI HOŞAFI", oldLoc: "B-108" }
    ];

    let currentResults = [];
    let currentFilter = 'ALL';

    // String normalization for Turkish fuzzy match
    function normalizeTr(str) {
      if (!str) return '';
      return str
        .toLowerCase()
        .replace(/ı/g, 'i')
        .replace(/ğ/g, 'g')
        .replace(/ü/g, 'u')
        .replace(/ş/g, 's')
        .replace(/ö/g, 'o')
        .replace(/ç/g, 'c')
        .replace(/[^a-z0-9]/g, '');
    }

    // Warehouse shorthand aliases
    const SHORTCUTS = {
      "ruzsal": "RUS SALATASI",
      "haydarl": "HAYDARİ",
      "zaksuka": "ŞAKŞUKA",
      "hadtavgogsubasmati": "HAŞLANMIŞ TAVUK GÖĞSÜ VE BASMATİ PİRİNÇ PİLAVI",
      "hibduetlisiye": "HİNDİ ETLİ SİYEZ BULGUR PİLAVI",
      "yaylacor": "AYRAN AŞI ÇORBASI",
      "sehriyelicor": "ŞEHRİYELİ TAVUK ÇORBASI",
      "mercimekcor": "MERCİMEK ÇORBASI",
      "ezogelincor": "EZOGELİN ÇORBASI",
      "dolutos": "DORITOS DOLUTOS",
      "damlacikpankek": "DAMLA ÇİKOLATALI PANCAKE",
      "korisoslutav": "KÖRİ SOSLU TAVUK VE KESME PEYNİRLİ ERİŞTE",
      "nohutlutavpil": "NOHUTLU PİLAV VE TAVUK",
      "tavsebzelinoodle": "TAVUKLU SEBZELİ NOODLE",
      "lahanasarma": "ZEYTİNYAĞLI LAHANA SARMA",
      "barbunyapilaki": "ZEYTİNYAĞLI BARBUNYA PİLAKİ 250 GR",
      "cigkoftesushi": "ÇİĞ KÖFTE SUSHİ",
      "begendilikofte": "BEĞENDİLİ KÖFTE",
      "begendilitavuksote": "BEĞENDİLİ TAVUK SOTE",
      "izgaratavsis": "IZGARA TAVUK ŞİŞ VE SİYEZ BULGURU",
      "vegankoftemakarna": "VEGAN KÖFTE VE MAKARNA",
      "maccheese": "MAC&CHEESE",
      "macecheese": "MAC&CHEESE",
      "izmirkofte": "İZMİR KÖFTE",
      "tatlieksi": "TATLI EKŞİ SOSLU TAVUK SOTE VE ALFREDO SOSLU SPAGETTİ",
      "kinoakisiri": "KİNOA KISIRI",
      "hinditandir": "HİNDİ TANDIRLI İÇ PİLAV",
      "tahinpekmezlipankek": "TAHİN PEKMEZLİ PANCAKE",
      "tavsedat": "TAVUKLU SEZAR SALATA",
      "falafelliborek": "FALAFELLİ BOWL",
      "kurucaciklibiwl": "KURU CACIKLI TAVUKLU TABULE BOWL",
      "kurucacikli": "KURU CACIKLI TAVUKLU TABULE BOWL"
    };

    function findBestMatch(queryText, masterList, usedCodes) {
      const qNorm = normalizeTr(queryText);
      if (!qNorm) return null;

      // 1. Shorthand check
      if (SHORTCUTS[qNorm]) {
        const target = SHORTCUTS[qNorm];
        const item = masterList.find(m => m.name === target && !usedCodes.has(m.code));
        if (item) return item;
      }

      // 2. Exact match
      for (const item of masterList) {
        if (usedCodes.has(item.code)) continue;
        if (normalizeTr(item.name) === qNorm) return item;
      }

      // 3. Inclusion match
      for (const item of masterList) {
        if (usedCodes.has(item.code)) continue;
        const iNorm = normalizeTr(item.name);
        if (iNorm.includes(qNorm) || qNorm.includes(iNorm)) {
          return item;
        }
      }

      // 4. Token keyword matching
      const qTokens = queryText.toLowerCase().replace(/[^a-z0-9ğüşıöç ]/g, ' ').split(/\s+/).filter(t => t.length > 2);
      let bestItem = null;
      let maxScore = 0;

      for (const item of masterList) {
        if (usedCodes.has(item.code)) continue;
        const iNameLower = item.name.toLowerCase();
        let score = 0;
        for (const token of qTokens) {
          if (iNameLower.includes(token)) score++;
        }
        if (score > maxScore && score >= Math.min(2, qTokens.length)) {
          maxScore = score;
          bestItem = item;
        }
      }

      return bestItem;
    }

    function setMode(mode) {
      document.getElementById('unselectedMode').value = mode;
      const seqBtn = document.getElementById('modeSeqBtn');
      const fixBtn = document.getElementById('modeFixBtn');

      if (mode === 'sequential') {
        seqBtn.className = "flex-1 py-1.5 rounded-xl transition-all shadow-xs bg-white text-slate-900 font-semibold";
        fixBtn.className = "flex-1 py-1.5 rounded-xl transition-all text-slate-600 hover:text-slate-900";
      } else {
        fixBtn.className = "flex-1 py-1.5 rounded-xl transition-all shadow-xs bg-white text-slate-900 font-semibold";
        seqBtn.className = "flex-1 py-1.5 rounded-xl transition-all text-slate-600 hover:text-slate-900";
      }
    }

    function processAddressing() {
      const rawInput = document.getElementById('orderInput').value.trim();
      if (!rawInput) {
        showToast('Lütfen önce sıralanacak ürün listesini yapıştırın', 'warning');
        return;
      }

      const lines = rawInput.split('\n').map(l => l.trim()).filter(l => l.length > 0);
      const unselectedMode = document.getElementById('unselectedMode').value;

      const usedCodes = new Set();
      const matchedA = [];
      const notFoundQueries = [];

      lines.forEach((query) => {
        const match = findBestMatch(query, MASTER_DATA, usedCodes);
        if (match) {
          usedCodes.add(match.code);
          matchedA.push({
            query: query,
            code: match.code,
            name: match.name,
            oldLoc: match.oldLoc,
            group: 'A'
          });
        } else {
          notFoundQueries.push(query);
        }
      });

      // A-001, A-002...
      matchedA.forEach((item, idx) => {
        const num = 1 + idx;
        item.newLoc = `A-${String(num).padStart(3, '0')}`;
        item.sira = idx + 1;
      });

      // Unselected items (B Group)
      const unselected = MASTER_DATA.filter(item => !usedCodes.has(item.code));
      let bCounter = 1;

      const formattedB = unselected.map((item, idx) => {
        let newLoc = 'B-001';
        if (unselectedMode === 'sequential') {
          newLoc = `B-${String(bCounter).padStart(3, '0')}`;
          bCounter++;
        }
        return {
          sira: matchedA.length + idx + 1,
          newLoc: newLoc,
          code: item.code,
          name: item.name,
          oldLoc: item.oldLoc,
          group: 'B'
        };
      });

      currentResults = [...matchedA, ...formattedB];

      document.getElementById('statMatched').textContent = matchedA.length;
      document.getElementById('statUnmatched').textContent = formattedB.length;

      renderTable();
      showToast(`${matchedA.length} ürün A grubuna adreslendi`, 'success');
    }

    function renderTable() {
      const tbody = document.getElementById('resultsTableBody');
      const searchTerm = normalizeTr(document.getElementById('tableSearch').value || '');
      tbody.innerHTML = '';

      const filtered = currentResults.filter(item => {
        if (currentFilter !== 'ALL' && item.group !== currentFilter) return false;
        if (searchTerm) {
          const hay = normalizeTr(item.code + item.name + item.newLoc + item.oldLoc);
          return hay.includes(searchTerm);
        }
        return true;
      });

      document.getElementById('tableRowCount').textContent = `${filtered.length} kayıt`;

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="py-12 text-center text-slate-400">
              <i class="ph ph-magnifying-glass text-3xl mb-1 text-slate-300 block"></i>
              Eşleşen ürün bulunamadı
            </td>
          </tr>
        `;
        return;
      }

      filtered.forEach((row) => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50/70 transition-colors border-b border-slate-100";

        const isA = row.group === 'A';
        const locBadge = isA
          ? `<span class="inline-flex items-center px-2 py-0.5 rounded-lg font-mono font-semibold text-xs bg-emerald-50 text-emerald-700 border border-emerald-200/60">${row.newLoc}</span>`
          : `<span class="inline-flex items-center px-2 py-0.5 rounded-lg font-mono font-semibold text-xs bg-amber-50 text-amber-700 border border-amber-200/60">${row.newLoc}</span>`;

        tr.innerHTML = `
          <td class="py-2.5 px-3 text-center text-slate-400 font-mono text-[11px]">${row.sira}</td>
          <td class="py-2.5 px-3 text-center">${locBadge}</td>
          <td class="py-2.5 px-3 font-mono text-slate-400 text-[11px]">${row.code}</td>
          <td class="py-2.5 px-3 font-medium text-slate-800">
            ${row.name}
            ${row.query && row.query !== row.name ? `<span class="text-[10px] block text-slate-400 font-normal">Aranan: ${row.query}</span>` : ''}
          </td>
          <td class="py-2.5 px-3 text-center text-slate-400 font-mono text-[11px]">${row.oldLoc}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function setFilter(filter) {
      currentFilter = filter;
      ['ALL', 'A', 'B'].forEach(f => {
        const btn = document.getElementById(`filterBtn${f}`);
        if (f === filter) {
          btn.className = "px-2.5 py-1 rounded-lg bg-white text-slate-900 font-semibold shadow-2xs";
        } else {
          btn.className = "px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900";
        }
      });
      renderTable();
    }

    function filterTable() {
      renderTable();
    }

    function clearInput() {
      document.getElementById('orderInput').value = '';
      updateLineCount();
    }

    function updateLineCount() {
      const text = document.getElementById('orderInput').value.trim();
      const count = text ? text.split('\n').filter(l => l.trim().length > 0).length : 0;
      document.getElementById('inputLineCount').textContent = `${count} satır girildi`;
    }

    document.getElementById('orderInput').addEventListener('input', updateLineCount);

