<!DOCTYPE html>
<html lang="tr" class="h-full bg-[#F2F2F7]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Depo Adresleyici Pro - Mikro ERP</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SheetJS for Excel generation -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <!-- Phosphor Icons for iOS-like glyphs -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Plus Jakarta Sans", -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
    }
    .font-mono-code { font-family: 'JetBrains Mono', monospace; }
    
    /* iOS Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #D1D1D6;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #8E8E93;
    }

    /* Print Styles for A4 Warehouse Handout */
    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
      header, .no-print, #leftPanel, #toast, .action-buttons {
        display: none !important;
      }
      main {
        display: block !important;
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      #rightPanel {
        width: 100% !important;
      }
      .printable-card {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
      }
      .print-header {
        display: block !important;
      }
      table {
        font-size: 10pt !important;
        width: 100% !important;
      }
      th, td {
        padding: 4px 6px !important;
        border-bottom: 1px solid #ddd !important;
      }
    }
    .print-header { display: none; }
  </style>
</head>
<body class="min-h-full flex flex-col bg-[#F2F2F7] text-slate-900 select-none sm:select-auto">

  <!-- iOS Top Navigation Bar -->
  <header class="sticky top-0 z-30 bg-white/80 backdrop-blur-xl border-b border-black/[0.08] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
      
      <!-- Brand & Status -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[14px] bg-[#007AFF] text-white flex items-center justify-center shadow-md shadow-blue-500/25">
          <i class="ph ph-cube text-xl font-bold"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-[16px] font-bold text-slate-900 tracking-tight leading-tight">Depo Adres Dağıtıcı</h1>
            <span class="text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-600 px-2 py-0.5 rounded-full border border-blue-200/60">v2.5 Pro</span>
          </div>
          <p class="text-[11px] text-slate-500 font-medium">108 Stok Kartı • Mikro ERP Raf Entegratörü</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2 no-print">
        <button onclick="printOrderSheet()" title="Yazdır veya PDF Kaydet" class="hidden sm:inline-flex px-3 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200/80 shadow-2xs transition items-center gap-1.5 active:scale-95">
          <i class="ph ph-printer text-sm"></i>
          <span>Yazdır</span>
        </button>

        <button onclick="copyTableToClipboard()" title="Panoya Kopyala" class="px-3 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200/80 shadow-2xs transition flex items-center gap-1.5 active:scale-95">
          <i class="ph ph-copy-simple text-sm"></i>
          <span class="hidden sm:inline">Kopyala</span>
        </button>

        <!-- Dropdown / Action for Excel -->
        <div class="relative inline-block text-left">
          <button onclick="exportToExcel()" class="px-3.5 py-2 rounded-xl bg-[#007AFF] hover:bg-[#0071E3] text-white text-xs font-semibold shadow-sm shadow-blue-500/30 transition flex items-center gap-1.5 active:scale-95">
            <i class="ph ph-file-arrow-down text-base font-bold"></i>
            <span>Excel İndir</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Print Sheet Title (Only visible in Print) -->
  <div class="print-header p-6 pb-2">
    <div class="flex justify-between items-center border-b pb-3 mb-3">
      <div>
        <h2 class="text-xl font-bold">DEPO RAF TOPLAMA VE ADRES LİSTESİ</h2>
        <p class="text-xs text-gray-500">Mikro ERP Stok Depo Yer Kodları Güncelleme Formu</p>
      </div>
      <div class="text-right text-xs text-gray-600">
        <p>Tarih: <span id="printDate"></span></p>
        <p>Toplam Ürün: <span id="printTotal"></span></p>
      </div>
    </div>
  </div>

  <!-- Main View -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-3 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-5">

    <!-- Sol Bölüm: Girdi & Ayarlar (lg: 5 Kolon) -->
    <div id="leftPanel" class="lg:col-span-5 flex flex-col gap-4">

      <!-- Ürün Listesi Giriş Kartı -->
      <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-xs border border-black/[0.04] flex flex-col gap-3">
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <i class="ph ph-list-numbers text-base text-blue-500 font-bold"></i>
            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Toplanacak Ürün Listesi</span>
          </div>

          <div class="flex items-center gap-1.5">
            <button onclick="clearInput()" title="Temizle" class="text-xs text-slate-400 hover:text-rose-500 p-1 rounded-lg transition active:scale-90">
              <i class="ph ph-trash text-sm"></i>
            </button>
          </div>
        </div>

        <!-- Hızlı Şablon Hapları -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-[11px]">
          <span class="text-slate-400 font-medium text-[10px] whitespace-nowrap">Hızlı Yükle:</span>
          <button onclick="loadSample(1)" class="px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200/80 text-slate-600 font-medium whitespace-nowrap transition active:scale-95">
            Örnek (36 Ürün)
          </button>
          <button onclick="loadSample(2)" class="px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200/80 text-slate-600 font-medium whitespace-nowrap transition active:scale-95">
            Sandviç & Sushi (19)
          </button>
          <button onclick="loadSample(3)" class="px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200/80 text-slate-600 font-medium whitespace-nowrap transition active:scale-95">
            Çorba & Börek (25)
          </button>
        </div>

        <div class="relative">
          <textarea id="orderInput" rows="11" class="w-full bg-[#F2F2F7]/70 hover:bg-[#F2F2F7] focus:bg-white text-slate-800 placeholder-slate-400 text-xs sm:text-[13px] leading-relaxed p-3.5 rounded-2xl border border-transparent focus:border-blue-500/30 focus:ring-4 focus:ring-blue-500/10 focus:outline-none transition resize-y font-mono-code" placeholder="Sırayla ürün adlarını alt alta yapıştırın:
Su böreği
Çiğ köfte Sushi
Kabak mücver
Acılı ezme
Rus salatası..."></textarea>
        </div>

        <div class="flex items-center justify-between text-[11px] text-slate-400 px-1 font-medium">
          <span id="inputLineCount">0 ürün girildi</span>
          <span>A-001'den başlayıp sıralanır</span>
        </div>
      </div>

      <!-- Ayarlar & Aksiyon Kartı -->
      <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-xs border border-black/[0.04] flex flex-col gap-4">
        
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
              <i class="ph ph-sliders-horizontal text-blue-500"></i> Listede Olmayan Ürünler (B Grubu)
            </label>
            <span class="text-[10px] text-slate-400 font-mono" id="bGroupCountLabel">72 ürün</span>
          </div>

          <!-- iOS Segmented Control -->
          <div class="bg-[#E5E5EA] p-1 rounded-2xl flex text-xs font-semibold">
            <button type="button" id="modeSeqBtn" onclick="setMode('sequential')" class="flex-1 py-1.5 rounded-xl transition-all shadow-xs bg-white text-slate-900">
              B-001'den Sıralı
            </button>
            <button type="button" id="modeFixBtn" onclick="setMode('fixed')" class="flex-1 py-1.5 rounded-xl transition-all text-slate-600 hover:text-slate-900">
              Tümü Sabit B-001
            </button>
          </div>
          <input type="hidden" id="unselectedMode" value="sequential">
        </div>

        <!-- Ana Sıralama Butonu (iOS Blue Pill) -->
        <button onclick="processAddressing()" class="w-full py-3.5 px-4 rounded-2xl bg-[#007AFF] hover:bg-[#0071E3] active:scale-[0.98] text-white text-sm font-bold shadow-md shadow-blue-500/25 transition flex items-center justify-center gap-2">
          <i class="ph ph-lightning text-lg font-bold"></i>
          <span>Adresleri Hesapla & Sırala</span>
        </button>

      </div>

      <!-- Eşleşmeyen / Uyarı Kartı (Gerektiğinde görünür) -->
      <div id="unmatchedAlertCard" class="hidden bg-rose-50 border border-rose-200/80 rounded-3xl p-4 text-xs text-rose-800 flex flex-col gap-2 transition-all">
        <div class="flex items-center gap-2 font-bold text-rose-900">
          <i class="ph ph-warning-circle text-base"></i>
          <span id="unmatchedCountText">0 ürün eşleştirilemedi</span>
        </div>
        <p class="text-[11px] text-rose-700 leading-normal">Aşağıdaki satırlar veritabanındaki 108 ürünle eşleşmedi. Yazımı kontrol edebilirsiniz:</p>
        <ul id="unmatchedList" class="font-mono text-[11px] bg-white/70 rounded-xl p-2.5 divide-y divide-rose-100 max-h-28 overflow-y-auto"></ul>
      </div>

    </div>

    <!-- Sağ Bölüm: Sonuçlar & Tablo (lg: 7 Kolon) -->
    <div id="rightPanel" class="lg:col-span-7 flex flex-col gap-3">

      <!-- iOS Widget Tarzı Mini İstatistikler -->
      <div class="grid grid-cols-3 gap-3">
        <!-- A Grubu -->
        <div class="bg-white rounded-2xl p-3 shadow-xs border border-black/[0.04] flex flex-col">
          <span class="text-[11px] font-semibold text-emerald-600 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> A Grubu
          </span>
          <div class="flex items-baseline justify-between mt-1">
            <span id="statMatched" class="text-xl sm:text-2xl font-bold font-mono text-slate-800">0</span>
            <span class="text-[10px] text-slate-400">Öncelikli Raf</span>
          </div>
        </div>

        <!-- B Grubu -->
        <div class="bg-white rounded-2xl p-3 shadow-xs border border-black/[0.04] flex flex-col">
          <span class="text-[11px] font-semibold text-amber-600 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> B Grubu
          </span>
          <div class="flex items-baseline justify-between mt-1">
            <span id="statUnmatched" class="text-xl sm:text-2xl font-bold font-mono text-slate-800">108</span>
            <span class="text-[10px] text-slate-400">Atıl / Diğer</span>
          </div>
        </div>

        <!-- Toplam Stok -->
        <div class="bg-white rounded-2xl p-3 shadow-xs border border-black/[0.04] flex flex-col">
          <span class="text-[11px] font-semibold text-slate-500 flex items-center gap-1">
            <i class="ph ph-database text-xs"></i> Toplam Havuz
          </span>
          <div class="flex items-baseline justify-between mt-1">
            <span class="text-xl sm:text-2xl font-bold font-mono text-slate-800">108</span>
            <span class="text-[10px] text-emerald-600 font-medium" id="statMatchPercent">%0 aktif</span>
          </div>
        </div>
      </div>

      <!-- Tablo Kartı -->
      <div class="printable-card bg-white rounded-3xl shadow-xs border border-black/[0.04] flex-1 flex flex-col overflow-hidden">
        
        <!-- Tablo Araç Çubuğu -->
        <div class="p-3 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2.5 bg-slate-50/60 no-print">
          
          <!-- Arama Kutusu -->
          <div class="relative flex-1 min-w-[200px]">
            <i class="ph ph-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
            <input type="text" id="tableSearch" onkeyup="filterTable()" placeholder="Stok kodu, adı veya raf ara..." class="w-full bg-white border border-slate-200/80 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 transition">
          </div>

          <!-- Filtre Segmenti -->
          <div class="bg-[#E5E5EA] p-0.5 rounded-xl flex text-[11px] font-semibold">
            <button onclick="setFilter('ALL')" id="filterBtnALL" class="px-3 py-1 rounded-lg bg-white text-slate-900 shadow-2xs">Tümü</button>
            <button onclick="setFilter('A')" id="filterBtnA" class="px-3 py-1 rounded-lg text-slate-600 hover:text-slate-900">A Grubu</button>
            <button onclick="setFilter('B')" id="filterBtnB" class="px-3 py-1 rounded-lg text-slate-600 hover:text-slate-900">B Grubu</button>
          </div>

          <span class="text-[11px] text-slate-400 whitespace-nowrap font-medium" id="tableRowCount">108 kayıt</span>
        </div>

        <!-- Kaydırılabilir Tablo -->
        <div class="flex-1 overflow-y-auto max-h-[620px] relative">
          <table class="w-full text-left border-collapse text-xs">
            <thead class="bg-slate-50/90 text-slate-500 sticky top-0 z-10 font-bold border-b border-slate-200/60 backdrop-blur-xs">
              <tr>
                <th class="py-2.5 px-3 text-center w-12 text-[11px] text-slate-400">#</th>
                <th class="py-2.5 px-3 text-center w-24">Yeni Yer Kodu</th>
                <th class="py-2.5 px-3 w-32 font-mono text-slate-400">sto_kod</th>
                <th class="py-2.5 px-3">sto_isim (Stok Adı)</th>
                <th class="py-2.5 px-3 text-center w-16 text-slate-400">Eski</th>
                <th class="py-2.5 px-2 text-center w-16 no-print">Sıra Değiş</th>
              </tr>
            </thead>
            <tbody id="resultsTableBody" class="divide-y divide-slate-100 text-slate-700">
              <!-- JS dinamik doldurur -->
            </tbody>
          </table>
        </div>

        <!-- Tablo Alt Bilgi Çubuğu -->
        <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400 no-print">
          <span>A Grubu ürünleri tablodaki oklarla yukarı/aşağı taşıyabilirsiniz.</span>
          <span class="font-mono text-slate-500">Mikro v16/v17 Uyumlu</span>
        </div>

      </div>

    </div>

  </main>

  <!-- iOS Dynamic Capsule Toast -->
  <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 bg-slate-900/95 backdrop-blur-md text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-2xl border border-white/10 flex items-center gap-2 transform -translate-y-20 opacity-0 pointer-events-none transition-all duration-300">
    <i id="toastIcon" class="ph ph-check-circle text-emerald-400 text-base"></i>
    <span id="toastMsg">İşlem başarıyla yapıldı</span>
  </div>

