    function exportToExcel() {
      if (currentResults.length === 0) {
        showToast('Dışa aktarmak için önce bir liste oluşturun', 'warning');
        return;
      }

      const excelData = currentResults.map(item => ({
        "Sıra No": item.sira,
        "Yeni Adres (sto_yer_kod)": item.newLoc,
        "Stok Kodu (sto_kod)": item.code,
        "Stok İsmi (sto_isim)": item.name,
        "Eski Adres": item.oldLoc,
        "Grup": item.group === 'A' ? 'A Grubu (Seçilen)' : 'B Grubu (Diğer)'
      }));

      const wb = XLSX.utils.book_new();
      const ws = XLSX.utils.json_to_sheet(excelData);

      ws['!cols'] = [
        { wch: 8 },
        { wch: 24 },
        { wch: 18 },
        { wch: 50 },
        { wch: 14 },
        { wch: 20 }
      ];

      XLSX.utils.book_append_sheet(wb, ws, "Depo_Adresleri");
      XLSX.writeFile(wb, `Depo_Raf_Adresleri_${new Date().toISOString().slice(0, 10)}.xlsx`);
      showToast('Excel dosyası indirildi', 'success');
    }

    function copyTableToClipboard() {
      if (currentResults.length === 0) {
        showToast('Kopyalanacak veri yok', 'warning');
        return;
      }

      let tsv = "Sıra\tYeni Adres\tStok Kodu\tStok İsmi\tEski Adres\n";
      currentResults.forEach(r => {
        tsv += `${r.sira}\t${r.newLoc}\t${r.code}\t${r.name}\t${r.oldLoc}\n`;
      });

      const tempArea = document.createElement('textarea');
      tempArea.value = tsv;
      document.body.appendChild(tempArea);
      tempArea.select();
      try {
        document.execCommand('copy');
        showToast('Tablo kopyalandı, Excel\'e yapıştırabilirsiniz', 'success');
      } catch (err) {
        showToast('Kopyalama yapılamadı', 'warning');
      }
      document.body.removeChild(tempArea);
    }

    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      toastMsg.textContent = msg;
      if (type === 'warning') {
        toastIcon.className = "ph ph-warning-circle text-amber-400 text-base";
      } else {
        toastIcon.className = "ph ph-check-circle text-emerald-400 text-base";
      }

      toast.classList.remove('-translate-y-16', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.add('-translate-y-16', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 2800);
    }

    window.onload = function() {
      loadLatestOrder();
    };
