  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Plus Jakarta Sans", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .font-mono-code { font-family: 'JetBrains Mono', monospace; }
    /* iOS style scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="min-h-full flex flex-col bg-[#F2F2F7] text-slate-850">

  <!-- iOS Navigation Bar -->
  <header class="sticky top-0 z-30 bg-white/80 backdrop-blur-md border-b border-black/[0.06] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-2xl bg-blue-500 text-white flex items-center justify-center shadow-sm shadow-blue-500/30">
          <i class="ph ph-squares-four text-xl font-bold"></i>
        </div>
        <div>
          <h1 class="text-[15px] font-semibold text-slate-900 tracking-tight flex items-center gap-2">
            Depo Adresleyici
            <span class="text-[11px] font-semibold bg-blue-50 text-blue-600 px-2 py-0.5 rounded-full border border-blue-200/50">Mikro ERP</span>
          </h1>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2">
        <button onclick="copyTableToClipboard()" class="px-3 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200/80 shadow-xs transition flex items-center gap-1.5 active:scale-95">
          <i class="ph ph-copy text-sm"></i>
          <span>Kopyala</span>
        </button>
        <button onclick="exportToExcel()" class="px-3.5 py-1.5 rounded-xl bg-[#007AFF] hover:bg-blue-600 text-white text-xs font-semibold shadow-sm shadow-blue-500/20 transition flex items-center gap-1.5 active:scale-95">
          <i class="ph ph-download-simple text-sm font-bold"></i>
          <span>Excel İndir</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main View -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-5">

    <!-- Sol Bölüm: Girdi & Ayarlar (4 Kolon) -->
    <div class="lg:col-span-5 flex flex-col gap-4">

      <!-- Liste Giriş Kartı -->
      <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-black/[0.04] flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
            <i class="ph ph-text-align-left text-sm text-blue-500"></i> Ürün Listesi
          </span>
          <div class="flex items-center gap-1.5">
            <button onclick="loadLatestOrder()" class="text-[11px] text-blue-600 hover:text-blue-700 bg-blue-50/70 hover:bg-blue-100/70 px-2.5 py-1 rounded-full font-medium transition active:scale-95">
              Son Listen
            </button>
            <button onclick="clearInput()" class="text-[11px] text-slate-400 hover:text-rose-500 p-1 rounded-md transition">
              <i class="ph ph-trash text-sm"></i>
            </button>
          </div>
        </div>

        <textarea id="orderInput" rows="12" class="w-full bg-[#F2F2F7]/70 hover:bg-[#F2F2F7] focus:bg-white text-slate-800 placeholder-slate-400 text-xs sm:text-[13px] leading-relaxed p-3.5 rounded-2xl border border-transparent focus:border-blue-500/30 focus:ring-4 focus:ring-blue-500/10 focus:outline-none transition resize-y" placeholder="Ürünleri alt alta yapıştırın:
Su böreği
Çiğ köfte Sushi
Kabak mücver
Şakşuka
Mercimek çorbası..."></textarea>

        <div class="flex items-center justify-between text-[11px] text-slate-400 px-1">
          <span id="inputLineCount">0 satır girildi</span>
          <span>Her satıra 1 ürün</span>
        </div>
      </div>

      <!-- Ayarlar & Aksiyon Kartı -->
      <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-black/[0.04] flex flex-col gap-4">
        
        <div>
          <label class="text-xs font-semibold text-slate-600 block mb-2">Listede Olmayan Ürünler</label>
          <!-- iOS Segmented Control -->
          <div class="bg-[#E5E5EA] p-1 rounded-2xl flex text-xs font-medium">
            <button type="button" id="modeSeqBtn" onclick="setMode('sequential')" class="flex-1 py-1.5 rounded-xl transition-all shadow-xs bg-white text-slate-900 font-semibold">
              B-001'den Sıralı
            </button>
            <button type="button" id="modeFixBtn" onclick="setMode('fixed')" class="flex-1 py-1.5 rounded-xl transition-all text-slate-600 hover:text-slate-900">
              Tümü Sabit B-001
            </button>
          </div>
          <input type="hidden" id="unselectedMode" value="sequential">
        </div>

        <!-- Ana Sıralama Butonu (iOS Pill Action) -->
        <button onclick="processAddressing()" class="w-full py-3.5 px-4 rounded-2xl bg-[#007AFF] hover:bg-[#0071E3] active:scale-[0.98] text-white text-sm font-semibold shadow-md shadow-blue-500/20 transition flex items-center justify-center gap-2">
          <i class="ph ph-lightning text-lg font-bold"></i>
          <span>Adresleri Hesapla & Sırala</span>
        </button>

      </div>

    </div>

    <!-- Sağ Bölüm: Sonuçlar & Tablo (7 Kolon) -->
    <div class="lg:col-span-7 flex flex-col gap-3">

      <!-- iOS Style Stats Bar -->
      <div class="bg-white rounded-2xl px-4 py-3 shadow-sm border border-black/[0.04] flex items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200/50">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            A Grubu: <span id="statMatched" class="font-mono">0</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 font-semibold border border-amber-200/50">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            B Grubu: <span id="statUnmatched" class="font-mono">108</span>
          </span>
        </div>

        <!-- Filtre Sekmesi (Segmented) -->
        <div class="bg-[#E5E5EA] p-0.5 rounded-xl flex text-[11px] font-medium">
          <button onclick="setFilter('ALL')" id="filterBtnALL" class="px-2.5 py-1 rounded-lg bg-white text-slate-900 font-semibold shadow-2xs">Tümü</button>
          <button onclick="setFilter('A')" id="filterBtnA" class="px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900">A Grubu</button>
          <button onclick="setFilter('B')" id="filterBtnB" class="px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900">B Grubu</button>
        </div>
      </div>

      <!-- Tablo Kartı -->
      <div class="bg-white rounded-3xl shadow-sm border border-black/[0.04] flex-1 flex flex-col overflow-hidden">
        
        <!-- Tablo İçi Arama -->
        <div class="p-3 border-b border-slate-100 flex items-center gap-2 bg-slate-50/50">
          <div class="relative flex-1">
            <i class="ph ph-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
            <input type="text" id="tableSearch" onkeyup="filterTable()" placeholder="Stok adı, kodu veya yer koduna göre ara..." class="w-full bg-white border border-slate-200/80 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 transition">
          </div>
          <span class="text-[11px] text-slate-400 whitespace-nowrap" id="tableRowCount">108 kayıt</span>
        </div>

        <!-- Kaydırılabilir Liste Tablosu -->
        <div class="flex-1 overflow-y-auto max-h-[580px]">
          <table class="w-full text-left border-collapse text-xs">
            <thead class="bg-slate-50/80 text-slate-500 sticky top-0 z-10 font-semibold border-b border-slate-100 backdrop-blur-xs">
              <tr>
                <th class="py-2.5 px-3 text-center w-12 text-[11px] text-slate-400 font-medium">#</th>
                <th class="py-2.5 px-3 text-center w-24">Yeni Adres</th>
                <th class="py-2.5 px-3 w-28 font-mono text-slate-400">sto_kod</th>
                <th class="py-2.5 px-3">Ürün Adı (sto_isim)</th>
                <th class="py-2.5 px-3 text-center w-20 text-slate-400">Eski</th>
              </tr>
            </thead>
            <tbody id="resultsTableBody" class="divide-y divide-slate-100 text-slate-700">
              <!-- JS Tablo satırlarını üretir -->
            </tbody>
          </table>
        </div>

      </div>

    </div>

  </main>

