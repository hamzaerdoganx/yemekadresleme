    // Main Engine: Address Allocation
    function processAddressing() {
      const rawInput = document.getElementById('orderInput').value.trim();
      if (!rawInput) {
        showToast('Lütfen önce toplanacak ürün listesini yapıştırın', 'warning');
        return;
      }

      const lines = rawInput.split('\n').map(l => l.trim()).filter(l => l.length > 0);
      const usedCodes = new Set();
      matchedAItems = [];
      const notFoundQueries = [];

      lines.forEach((query) => {
        const match = findBestMatch(query, MASTER_DATA, usedCodes);
        if (match) {
          usedCodes.add(match.code);
          matchedAItems.push({
            query: query,
            code: match.code,
            name: match.name,
            oldLoc: match.oldLoc,
            group: 'A'
          });
        } else {
          notFoundQueries.push(query);
        }
      });

      // Show/Hide Unmatched Warnings
      const alertCard = document.getElementById('unmatchedAlertCard');
      const unmatchedList = document.getElementById('unmatchedList');
      if (notFoundQueries.length > 0) {
        alertCard.classList.remove('hidden');
        document.getElementById('unmatchedCountText').textContent = `${notFoundQueries.length} satır eşleştirilemedi`;
        unmatchedList.innerHTML = notFoundQueries.map(q => `<li class="py-1 px-1 flex justify-between"><span>${q}</span><span class="text-rose-400 text-[10px]">Stokta Yok</span></li>`).join('');
      } else {
        alertCard.classList.add('hidden');
      }

      // Assign A-001, A-002...
      matchedAItems.forEach((item, idx) => {
        item.newLoc = `A-${String(idx + 1).padStart(3, '0')}`;
        item.sira = idx + 1;
      });

      // Filter remaining 108 products into B Group
      const unselected = MASTER_DATA.filter(item => !usedCodes.has(item.code));
      unselectedBItems = unselected.map(item => ({
        code: item.code,
        name: item.name,
        oldLoc: item.oldLoc,
        group: 'B'
      }));

      recalculateBGroup();
      showToast(`${matchedAItems.length} ürün A-001'den başlayarak adreslendi!`, 'success');
    }

    function recalculateBGroup() {
      const unselectedMode = document.getElementById('unselectedMode').value;
      let bCounter = 1;

      const formattedB = unselectedBItems.map((item, idx) => {
        let newLoc = 'B-001';
        if (unselectedMode === 'sequential') {
          newLoc = `B-${String(bCounter).padStart(3, '0')}`;
          bCounter++;
        }
        return {
          sira: matchedAItems.length + idx + 1,
          newLoc: newLoc,
          code: item.code,
          name: item.name,
          oldLoc: item.oldLoc,
          group: 'B'
        };
      });

      currentResults = [...matchedAItems, ...formattedB];

      // Update statistics
      const total = MASTER_DATA.length;
      const matched = matchedAItems.length;
      const percent = Math.round((matched / total) * 100);

      document.getElementById('statMatched').textContent = matched;
      document.getElementById('statUnmatched').textContent = formattedB.length;
      document.getElementById('bGroupCountLabel').textContent = `${formattedB.length} ürün`;
      document.getElementById('statMatchPercent').textContent = `%${percent} aktif`;

      renderTable();
    }

    // Move items in A group up or down
    function moveItem(index, direction) {
      if (direction === 'up' && index > 0) {
        const temp = matchedAItems[index];
        matchedAItems[index] = matchedAItems[index - 1];
        matchedAItems[index - 1] = temp;
      } else if (direction === 'down' && index < matchedAItems.length - 1) {
        const temp = matchedAItems[index];
        matchedAItems[index] = matchedAItems[index + 1];
        matchedAItems[index + 1] = temp;
      } else {
        return;
      }

      // Re-index A addresses
      matchedAItems.forEach((item, idx) => {
        item.newLoc = `A-${String(idx + 1).padStart(3, '0')}`;
        item.sira = idx + 1;
      });

      recalculateBGroup();
      showToast('Sıralama güncellendi', 'success');
    }

