                <i class="ph ph-caret-up text-xs font-bold"></i>
              </button>
              <button onclick="moveItem(${aIndex}, 'down')" title="Aşağı Taşı" class="p-1 rounded hover:bg-slate-200 text-slate-500 active:scale-90 transition ${aIndex === matchedAItems.length - 1 ? 'opacity-30 cursor-not-allowed' : ''}">
                <i class="ph ph-caret-down text-xs font-bold"></i>
              </button>
            </div>
          `;
        }

        tr.innerHTML = `
          <td class="py-2.5 px-3 text-center text-slate-400 font-mono text-[11px]">${row.sira}</td>
          <td class="py-2.5 px-3 text-center">${locBadge}</td>
          <td class="py-2.5 px-3 font-mono text-slate-400 text-[11px]">${row.code}</td>
          <td class="py-2.5 px-3">
            <span class="font-semibold text-slate-800">${row.name}</span>
            ${row.query && normalizeTr(row.query) !== normalizeTr(row.name) ? `<span class="text-[10px] block text-slate-400 font-normal">Aranan: "${row.query}"</span>` : ''}
          </td>
          <td class="py-2.5 px-3 text-center text-slate-400 font-mono text-[11px]">${row.oldLoc}</td>
          <td class="py-2.5 px-2 text-center no-print">${orderActions}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Segment Filter (ALL / A / B)
    function setFilter(filter) {
      currentFilter = filter;
      ['ALL', 'A', 'B'].forEach(f => {
        const btn = document.getElementById(`filterBtn${f}`);
        if (f === filter) {
          btn.className = "px-3 py-1 rounded-lg bg-white text-slate-900 shadow-2xs font-bold";
        } else {
          btn.className = "px-3 py-1 rounded-lg text-slate-600 hover:text-slate-900 font-semibold";
        }
      });
      renderTable();
    }

    function filterTable() {
      renderTable();
    }

    function clearInput() {
      document.getElementById('orderInput').value = '';
      updateLineCount();
      document.getElementById('unmatchedAlertCard').classList.add('hidden');
    }

    function updateLineCount() {
      const text = document.getElementById('orderInput').value.trim();
      const count = text ? text.split('\n').filter(l => l.trim().length > 0).length : 0;
      document.getElementById('inputLineCount').textContent = `${count} ürün girildi`;
    }

    document.getElementById('orderInput').addEventListener('input', updateLineCount);

    // Multi-Sheet Professional Excel Export
    function exportToExcel() {
      if (currentResults.length === 0) {
        showToast('Dışa aktarmak için önce bir liste oluşturun', 'warning');
        return;
      }

      const wb = XLSX.utils.book_new();

      // 1. Sheet: Full 108 Items (Mikro Import Ready)
      const fullData = currentResults.map(item => ({
        "Sıra": item.sira,
        "Yeni Adres (sto_yer_kod)": item.newLoc,
        "Stok Kodu (sto_kod)": item.code,
        "Stok İsmi (sto_isim)": item.name,
        "Eski Adres": item.oldLoc,
        "Grup": item.group === 'A' ? 'A Grubu (Toplanacak)' : 'B Grubu (Diğer)'
      }));
      const wsFull = XLSX.utils.json_to_sheet(fullData);
      wsFull['!cols'] = [{ wch: 6 }, { wch: 24 }, { wch: 18 }, { wch: 52 }, { wch: 12 }, { wch: 22 }];
      XLSX.utils.book_append_sheet(wb, wsFull, "Tum_Depo_Mikro");

      // 2. Sheet: Only A Group (Picking List)
      const aData = matchedAItems.map((item, idx) => ({
        "Sıra": idx + 1,
        "Raf Kodu (sto_yer_kod)": item.newLoc,
        "Stok Kodu": item.code,
        "Stok İsmi": item.name,
        "Eski Raf": item.oldLoc
      }));
      const wsA = XLSX.utils.json_to_sheet(aData);
      wsA['!cols'] = [{ wch: 6 }, { wch: 22 }, { wch: 18 }, { wch: 52 }, { wch: 12 }];
      XLSX.utils.book_append_sheet(wb, wsA, "Sadece_A_Grubu_Toplama");

      const today = new Date().toISOString().slice(0, 10);
      XLSX.writeFile(wb, `Mikro_Depo_Adresleri_${today}.xlsx`);
      showToast('Excel dosyası başarıyla indirildi', 'success');
    }

    // Copy TSV to Clipboard
    function copyTableToClipboard() {
      if (currentResults.length === 0) {
        showToast('Kopyalanacak veri yok', 'warning');
        return;
      }

      let tsv = "Sıra\tYeni Adres\tStok Kodu\tStok İsmi\tEski Adres\n";
      currentResults.forEach(r => {
        tsv += `${r.sira}\t${r.newLoc}\t${r.code}\t${r.name}\t${r.oldLoc}\n`;
      });

      const tempArea = document.createElement('textarea');
      tempArea.value = tsv;
      document.body.appendChild(tempArea);
      tempArea.select();
      try {
        document.execCommand('copy');
        showToast('Tablo kopyalandı! Excel veya ERP ekranına yapıştırabilirsiniz.', 'success');
      } catch (err) {
        showToast('Kopyalama yapılamadı', 'warning');
      }
      document.body.removeChild(tempArea);
    }

    // Print A4 Handout Sheet
    function printOrderSheet() {
      if (currentResults.length === 0) {
        showToast('Yazdırmak için önce liste oluşturun', 'warning');
        return;
      }
      document.getElementById('printDate').textContent = new Date().toLocaleString('tr-TR');
      document.getElementById('printTotal').textContent = `${matchedAItems.length} Aktif Raf / Toplam 108 Stok`;
      window.print();
    }

